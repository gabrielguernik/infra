${jsonencode({
  Version = "2012-10-17"
  Statement = [
    {
      Sid      = "EcrAccountLevel"
      Effect   = "Allow"
      Action   = ["ecr:GetAuthorizationToken", "ecr:DescribeRepositories", "ecr:DescribeRegistry"]
      Resource = "*"
    },
    {
      Sid      = "EcrRepos"
      Effect   = "Allow"
      Action   = ["ecr:*"]
      Resource = "arn:aws:ecr:${region}:${account_id}:repository/realworld-*"
    },
    {
      Sid      = "LogArchiveBucket"
      Effect   = "Allow"
      Action   = ["s3:*"]
      Resource = ["arn:aws:s3:::logs-${account_id}-${region}", "arn:aws:s3:::logs-${account_id}-${region}/*"]
    },
    {
      Sid      = "S3List"
      Effect   = "Allow"
      Action   = ["s3:ListAllMyBuckets"]
      Resource = "*"
    },
  ]
})}
