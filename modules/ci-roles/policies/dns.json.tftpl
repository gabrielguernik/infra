${jsonencode({
  Version = "2012-10-17"
  Statement = [
    {
      Sid      = "Route53Read"
      Effect   = "Allow"
      Action   = ["route53:Get*", "route53:List*"]
      Resource = "*"
    },
    {
      # CreateHostedZone cannot be scoped by zone name.
      Sid      = "EnvZone"
      Effect   = "Allow"
      Action   = ["route53:CreateHostedZone", "route53:DeleteHostedZone", "route53:ChangeTagsForResource", "route53:UpdateHostedZoneComment"]
      Resource = "*"
    },
    {
      Sid      = "ProtectParentZone"
      Effect   = "Deny"
      Action   = ["route53:DeleteHostedZone"]
      Resource = "arn:aws:route53:::hostedzone/${parent_zone_id}"
    },
    {
      # Only the delegation NS record for the environment subdomain.
      Sid      = "DelegationRecord"
      Effect   = "Allow"
      Action   = ["route53:ChangeResourceRecordSets"]
      Resource = "arn:aws:route53:::hostedzone/${parent_zone_id}"
      Condition = {
        "ForAllValues:StringEquals" = {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames" = ["${env_domain}"]
          "route53:ChangeResourceRecordSetsRecordTypes"           = ["NS"]
        }
      }
    },
  ]
})}
