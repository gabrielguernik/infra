${jsonencode({
  Version = "2012-10-17"
  Statement = [
    {
      Sid      = "Databases"
      Effect   = "Allow"
      Action   = ["rds:*", "elasticache:*"]
      Resource = "*"
    },
    {
      # App secrets, and the master-password secret that RDS creates on our behalf.
      Sid    = "Secrets"
      Effect = "Allow"
      Action = ["secretsmanager:*"]
      Resource = [
        "arn:aws:secretsmanager:${region}:${account_id}:secret:${env}/realworld/*",
        "arn:aws:secretsmanager:${region}:${account_id}:secret:rds!*",
      ]
    },
    {
      Sid      = "SecretsAccountLevel"
      Effect   = "Allow"
      Action   = ["secretsmanager:GetRandomPassword", "secretsmanager:ListSecrets", "kms:DescribeKey", "kms:ListAliases"]
      Resource = "*"
    },
    {
      Sid    = "SecurityGroups"
      Effect = "Allow"
      Action = [
        "ec2:Describe*",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:CreateTags",
        "ec2:DeleteTags",
      ]
      Resource = "*"
    },
    {
      Sid    = "Logs"
      Effect = "Allow"
      Action = ["logs:*"]
      Resource = [
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/rds/*",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/elasticache/*",
      ]
    },
    {
      Sid      = "LogsDescribe"
      Effect   = "Allow"
      Action   = ["logs:DescribeLogGroups"]
      Resource = "*"
    },
    {
      Sid      = "ServiceLinkedRoles"
      Effect   = "Allow"
      Action   = ["iam:CreateServiceLinkedRole"]
      Resource = "*"
      Condition = { StringEquals = { "iam:AWSServiceName" = [
        "rds.amazonaws.com",
        "elasticache.amazonaws.com",
      ] } }
    },
    {
      Sid      = "IamRead"
      Effect   = "Allow"
      Action   = ["iam:GetRole"]
      Resource = "*"
    },
  ]
})}
